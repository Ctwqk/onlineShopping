# Copy to .env and adjust. Everything has a working default, so this file is optional.

# ---- docker compose ----------------------------------------------------------------------------------------
APP_PORT=48080               # http://localhost:48080
MYSQL_HOST_PORT=43306        # published on 127.0.0.1 only (for IDE / mysql client access)
REDIS_HOST_PORT=46379        # published on 127.0.0.1 only
MYSQL_ROOT_PASSWORD=reggie-root
DB_PASSWORD=reggie

# dev  = demo seed data (see README) and the login code is echoed in the UI
# empty = schema only; then set REGGIE_ADMIN_PASSWORD to create the first administrator
SPRING_PROFILES_ACTIVE=dev
REGGIE_ADMIN_PASSWORD=

# ---- running the jar / IDE directly (same names are read by application.yml) --------------------------------
# DB_URL=jdbc:mysql://localhost:3306/reggie?characterEncoding=utf-8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# DB_USERNAME=reggie
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REGGIE_IMAGE_PATH=./data/images/
# SERVER_PORT=8080

# ---- how login codes are delivered: log (default) | sms | email --------------------------------------------
REGGIE_VERIFICATION_CHANNEL=log
# sms (Alibaba Cloud Dysmsapi)
# REGGIE_SMS_ACCESS_KEY_ID=
# REGGIE_SMS_ACCESS_KEY_SECRET=
# REGGIE_SMS_SIGN_NAME=
# REGGIE_SMS_TEMPLATE_CODE=
# email (any SMTP server; SPRING_MAIL_* are standard Spring Boot settings)
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=465
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_ENABLE=true
# REGGIE_EMAIL_FROM=
