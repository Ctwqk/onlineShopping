server:
  port: 8085
spring:
  application:
    #name of app
    name: online_shopping
  shardingsphere:
    datasource:
      names:
        master,slave
      # data source (master)
      master:
        type: com.alibaba.druid.pool.DruidDataSource
        driver-class-name: com.mysql.cj.jdbc.Driver
        url: jdbc:mysql://localhost:3306/reggie?characterEncoding=utf-8
        username: shoppinguser
        password: StrongP@ssword0.0
      # data source ( slaver)
      slave:
        type: com.alibaba.druid.pool.DruidDataSource
        driver-class-name: com.mysql.cj.jdbc.Driver
        url: jdbc:mysql://10.0.0.136:3306/reggie?characterEncoding=utf-8
        username: shoppinguser
        password: StrongP@ssword0.0
    masterslave:
      # rw-split
      load-balance-algorithm-type: round_robin #query method
      # data source name
      name: dataSource
      # major data source name
      master-data-source-name: master
      # slaver data source sources
      slave-data-source-names: slave
    props:
      sql:
        show: true #show sql response
  main:
    allow-bean-definition-overriding: true

  mail:
    host: smtp.163.com
    username: taiwei2023@163.com
    port: 465
    password: UHN95mG2Q7XP3feu
    protocol: smtp
    properties:
      mail:
        debug: ture
        smtp:
          ssl.enable: true
          socketFactory:
            port: 465
            class: javax.net.ssl.SSLSocketFactory
          auth: true
          starttls.enable: true
          #stattls.required: true
    default-encoding: utf-8


  redis:
    host: localhost
    port: 6379
    password: StrongP@ssword0.0
    database: 0
  cache:
    redis:
      time-to-live: 1800000 #redis fade away time
mybatis-plus:
  configuration:
    # rename from dao to mysql
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl
  global-config:
    db-config:
      id-type: ASSIGN_ID

reggie:
  image_path: /tmp/reggie_images



